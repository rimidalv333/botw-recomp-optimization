# PS5 runtime overrides
# File location: /data/savagewind/savagewind.env
# Syntax: NAME=value

# Examples of existing runtime switches (leave disabled unless intentionally testing):
# SAVAGEWIND_FPS_CAP=60
# SAVAGEWIND_AUDIO_GAIN=1.0
# SAVAGEWIND_NO_AUDIO=1
# SAVAGEWIND_NO_USER_INPUT=1

# Experimental optimization values
SAVAGEWIND_PROF_SVC=1
SAVAGEWIND_NO_PREEMPT=1
SAVAGEWIND_CORES=0
